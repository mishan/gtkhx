#: rust/crates/gtkhx-ui/src/options_window.rs:144
msgid "Trackers"
msgstr "Trackers"

#: rust/crates/gtkhx-ui/src/options.rs:789
msgid "Servers polled when the Tracker window opens"
msgstr "Servidores que se consultan al abrir la ventana del tracker"

#: rust/crates/gtkhx-ui/src/options.rs:827
msgid "URL"
msgstr "URL"

#: rust/crates/gtkhx-ui/src/options.rs:847
