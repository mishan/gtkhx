# ----------------------------------------------------------------
# Autotools generated files (will be replaced by Meson in Phase 1)
# ----------------------------------------------------------------
/configure
/configure~
/configure.scan
/aclocal.m4
/autom4te.cache/
/config.h
/config.h.in
/config.h.in~
/config.log
/config.status
/config.guess
/config.sub
/depcomp
/install-sh
/missing
/mkinstalldirs
/compile
/stamp-h
/stamp-h.in
/stamp-h1
/libtool
/ltmain.sh

# Per-directory generated Makefiles (autotools-era; the meson tree
# doesn't produce these). cicndump is a hand-written standalone
# tool with its own Makefile that we DO want tracked.
Makefile
Makefile.in
!tools/cicndump/Makefile

# gettext / NLS
/ABOUT-NLS
po/*.gmo
po/*.mo
po/stamp-po
po/POTFILES
po/Makevars.template
intl/Makefile

# Editor scratch files
*~
\#*\#
.\#*

# GtkHx build outputs (the in-tree executable from the legacy
# autotools build — meson puts everything under /build/, but the
# rule's harmless to keep).
#
# A previous `src/gtkhx_*` glob silently excluded legitimate
# sources like src/gtkhx_session.{c,h}. Build artifacts under
# src/ are unusual under meson; add specific names here when /
# if they appear.
src/gtkhx

# Plugin build outputs
plugins/*/*.so
plugins/sample/sample
plugins/eliza/eliza

# Meson / Ninja (Phase 1+)
/build/
/builddir/
.ninja_log
.ninja_deps

build.log
setup.log

# Flatpak (flatpak-builder)
/build-flatpak/
/.flatpak-builder/
/repo/
# Bundle output from tools/build-flatpak-bundle.sh — could be any
# name (-o flag), so ignore the extension wholesale.
*.flatpak

# Vendored mhxd clone — local reference per CLAUDE.md, never committed
/mhxd/
