*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# ----------------------------------------------------------------
# Autotools generated files (will be replaced by Meson in Phase 1)
# ----------------------------------------------------------------
/configure
/configure~
/configure.scan
/aclocal.m4
/autom4te.cache/
/config.h
/config.h.in
/config.h.in~
/config.log
/config.status
/config.guess
/config.sub
/depcomp
/install-sh
/missing
/mkinstalldirs
/compile
/stamp-h
/stamp-h.in
/stamp-h1
/libtool
/ltmain.sh

# Per-directory generated Makefiles (autotools-era; the meson tree
# doesn't produce these). cicndump is a hand-written standalone
# tool with its own Makefile that we DO want tracked.
Makefile
Makefile.in
!tools/cicndump/Makefile

# gettext / NLS
/ABOUT-NLS
po/*.gmo
po/*.mo
po/stamp-po
po/POTFILES
po/Makevars.template
intl/Makefile

# Editor scratch files
*~
\#*\#
.\#*

# GtkHx build outputs (the in-tree executable from the legacy
# autotools build — meson puts everything under /build/, but the
# rule's harmless to keep).
#
# A previous `src/gtkhx_*` glob silently excluded legitimate
# sources like src/gtkhx_session.{c,h}. Build artifacts under
# src/ are unusual under meson; add specific names here when /
# if they appear.
src/gtkhx

# Plugin build outputs
plugins/*/*.so
plugins/sample/sample
plugins/eliza/eliza

# Meson / Ninja (Phase 1+)
/build/
/builddir/
.ninja_log
.ninja_deps

build.log
setup.log

# Coverage build dir + HTML report. See tools/coverage.sh and
# docs/coverage.md. build-cov/ is a parallel meson build tree
# configured with -Db_coverage=true; coverage/ is the gcovr /
# genhtml output the script emits at the project root.
/build-cov/
/coverage/
# gcov sidecar files — they live inside build-cov/ normally, but
# the bare-pattern entries here catch any that get generated
# outside (e.g. from an ad-hoc gcc --coverage invocation).
*.gcno
*.gcda
*.gcov

# Flatpak (flatpak-builder)
/build-flatpak/
/.flatpak-builder/
/repo/
# Bundle output from tools/build-flatpak-bundle.sh — could be any
# name (-o flag), so ignore the extension wholesale.
*.flatpak

# Vendored mhxd clone — local reference per CLAUDE.md, never committed
/mhxd/

# Rust build output (Cargo workspace lives in rust/)
/rust/target/

# CI relocates the Cargo target dir + CARGO_HOME here via -Dcargo_target_dir so
# they can be cached (see .github/workflows/tests.yml). Only appear if you run
# that layout locally; never committed.
/rust-cargo-target/
/.cargo-home/
