<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phase 3.7: bundle the in-tree pixmaps as a GResource. Format is PNG.
  glib-compile-resources turns the listed files into a generated .c
  whose registered constructor runs at program load — no explicit
  g_resources_register() needed in main(). Call sites use
  gdk_pixbuf_new_from_resource("/com/nasledov/gtkhx/pixmaps/foo.png").
-->
<gresources>
  <gresource prefix="/com/nasledov/gtkhx">
    <file>pixmaps/ban.png</file>
    <!-- Broadcast button on the toolbar. Extracted from
         icons.rsrc cicn 220 via tools/cicndump. -->
    <file>pixmaps/broadcast.png</file>
    <file>pixmaps/chat.png</file>
    <file>pixmaps/connect.png</file>
    <file>pixmaps/dl.png</file>
    <file>pixmaps/down.png</file>
    <file>pixmaps/edituser.png</file>
    <file>pixmaps/files.png</file>
    <file>pixmaps/gtkhx.png</file>
    <!-- App icon. Aliased so GtkIconTheme finds them under the
         conventional <theme>/<size>/<context>/<name> layout once we
         register /com/nasledov/gtkhx/icons as a resource icon path
         (see gtkhx_activate). The icon-name "com.nasledov.gtkhx"
         matches our GApplication app-id, which is what the .desktop
         file's Icon= line is set to.
         Multiple sizes so the icon theme can pick the best match
         for whatever pixel size the requester needs (16 for menus,
         48-64 for taskbars, 128+ for the activities overview). The
         16-pixel source XPM is upscaled with nearest-neighbor to
         keep the pixel art crisp at large sizes; if a hand-drawn
         scalable SVG ever lands, it can join this list and the
         icon theme will prefer it. -->
    <file alias="icons/16x16/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_16.png</file>
    <file alias="icons/32x32/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_32.png</file>
    <file alias="icons/48x48/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_48.png</file>
    <file alias="icons/64x64/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_64.png</file>
    <file alias="icons/128x128/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_128.png</file>
    <file alias="icons/256x256/apps/com.nasledov.gtkhx.png">pixmaps/gtkhx_icon_256.png</file>
    <file>pixmaps/ignore.png</file>
    <file>pixmaps/info.png</file>
    <file>pixmaps/kick.png</file>
    <file>pixmaps/mkdir.png</file>
    <file>pixmaps/move.png</file>
    <file>pixmaps/msg.png</file>
    <file>pixmaps/news.png</file>
    <file>pixmaps/newscat.png</file>
    <file>pixmaps/newsfld.png</file>
    <file>pixmaps/newspost.png</file>
    <file>pixmaps/pencil.png</file>
    <file>pixmaps/newuser.png</file>
    <file>pixmaps/options.png</file>
    <file>pixmaps/postnews.png</file>
    <file>pixmaps/preview.png</file>
    <file>pixmaps/quit.png</file>
    <file>pixmaps/refresh.png</file>
    <file>pixmaps/start.png</file>
    <file>pixmaps/tasks.png</file>
    <file>pixmaps/tracker.png</file>
    <file>pixmaps/trash.png</file>
    <file>pixmaps/ul.png</file>
    <file>pixmaps/up.png</file>
    <file>pixmaps/users.png</file>

    <!-- File-type icons used by the new orthodox files browser.
         Extracted from the legacy icons.rsrc cicns once via
         tools/cicndump (see commit ... in this branch) so the
         new browser doesn't depend on the Mac resource fork
         being present at runtime. Naming maps cleanly to the
         ICON_* IDs in files.h via icon_resource_for_id. -->
    <file>pixmaps/file.png</file>
    <file>pixmaps/file_alias.png</file>
    <file>pixmaps/file_app.png</file>
    <file>pixmaps/file_disk.png</file>
    <file>pixmaps/file_html.png</file>
    <file>pixmaps/file_image.png</file>
    <file>pixmaps/file_move.png</file>
    <file>pixmaps/file_move_lr.png</file>
    <file>pixmaps/file_move_rl.png</file>
    <file>pixmaps/file_movie.png</file>
    <file>pixmaps/file_note.png</file>
    <file>pixmaps/file_sit.png</file>
    <file>pixmaps/file_text.png</file>
    <file>pixmaps/file_zip.png</file>
    <file>pixmaps/folder.png</file>
    <file>pixmaps/folder_dropbox.png</file>
  </gresource>
</gresources>
